{
  "short_name": "VendeusePro",
  "name": "VendeusePro AI - Créateur Contenu Vendeuse",
  "description": "L'application tout-en-un pour créer des photos studio pro, textes de vente WhatsApp/Instagram et vidéos en 3 clics.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "background_color": "#0F172A",
  "theme_color": "#0F172A",
  "orientation": "portrait-primary",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["business", "shopping", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Atelier Photo Studio",
      "short_name": "Photo Studio",
      "description": "Détourer et sublimer une photo produit",
      "url": "/?tab=photo",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Rédacteur Vente IA",
      "short_name": "Textes IA",
      "description": "Générer des textes WhatsApp & Instagram persuasifs",
      "url": "/?tab=copy",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Studio Vidéo & Voix",
      "short_name": "Vidéo Studio",
      "description": "Créer une vidéo promo avec musique et voix-off",
      "url": "/?tab=video",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Mes Créations Sauvegardées",
      "short_name": "Mes Créations",
      "description": "Accéder à l'historique de mes contenus",
      "url": "/?tab=gallery",
