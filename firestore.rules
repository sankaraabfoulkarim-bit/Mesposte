rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // UserProfile schema validation
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('slogan' in data) || (data.slogan is string && data.slogan.size() <= 200)) &&
        (data.currency in ['FCFA', 'EUR', 'USD', 'GNF', 'NGN', 'CDF', 'MAD']) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
        (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 80)) &&
        (!('facebookPage' in data) || (data.facebookPage is string && data.facebookPage.size() <= 120)) &&
        (data.plan in ['START', 'STANDARD', 'PREMIUM', 'VIP_UNLIMITED']) &&
        (data.credits is number && data.credits >= 0 && data.credits <= 100000) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500000));
    }

    // Creation schema validation
    function isValidCreation(data, userId) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('price' in data) || (data.price is string && data.price.size() <= 60)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 2000)) &&
        (!('tone' in data) || (data.tone in ['urgent', 'chic', 'friendly', 'storytelling', 'whatsapp'])) &&
        (data.type in ['image', 'video', 'copy', 'all-in-one']) &&
        (!('originalImageUrl' in data) || (data.originalImageUrl is string && data.originalImageUrl.size() <= 1500000)) &&
        (!('processedImageUrl' in data) || (data.processedImageUrl is string && data.processedImageUrl.size() <= 1500000)) &&
        (!('studioPresetId' in data) || (data.studioPresetId is string && data.studioPresetId.size() <= 64)) &&
        (!('badgeText' in data) || (data.badgeText is string && data.badgeText.size() <= 80)) &&
        (!('videoDuration' in data) || (data.videoDuration is number)) &&
        (!('musicTrackId' in data) || (data.musicTrackId is string && data.musicTrackId.size() <= 64)) &&
        (!('voiceId' in data) || (data.voiceId is string && data.voiceId.size() <= 64)) &&
        (!('isFavorite' in data) || (data.isFavorite is bool)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Match rules for Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No blanket listing of user profiles

      allow create: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId;

      allow delete: if isOwner(userId);

      // Subcollection: Creations
      match /creations/{creationId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(creationId) &&
          isValidCreation(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(creationId) &&
          isValidCreation(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id;

        allow delete: if isOwner(userId) && isValidId(creationId);
      }
    }
  }
}
